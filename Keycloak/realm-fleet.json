{
  "realm": "fleet-management",
  "displayName": "Système de Gestion de Flotte",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrateur — accès complet à toute la plateforme et gestion des droits"
      },
      {
        "name": "manager",
        "description": "Manager — supervise la flotte, les conducteurs et les alertes"
      },
      {
        "name": "technicien",
        "description": "Technicien — consulte et met à jour le statut des interventions de maintenance"
      },
      {
        "name": "utilisateur",
        "description": "Conducteur / Utilisateur — consulte ses assignations et utilise les véhicules"
      }
    ]
  },

  "clientScopes": [
    {
      "name": "fleet.read",
      "description": "Read-only access to Fleet APIs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read access to fleet APIs"
      }
    },
    {
      "name": "fleet.write",
      "description": "Write access to Fleet APIs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Write access to fleet APIs"
      }
    },
    {
      "name": "fleet.admin",
      "description": "Administrative access to Fleet APIs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Admin access to fleet APIs"
      }
    }
  ],

  "clients": [
    {
      "clientId": "fleet-frontend",
      "name": "Application Web Flotte",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["openid", "profile", "email", "roles", "fleet.read"],
      "optionalClientScopes": ["fleet.write", "fleet.admin"]
    },
    {
      "clientId": "fleet-api-gateway",
      "name": "API Gateway GraphQL",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "change-me-gateway-secret",
      "defaultClientScopes": ["roles", "fleet.read", "fleet.write"],
      "optionalClientScopes": ["fleet.admin"]
    },
    {
      "clientId": "vehicle-service",
      "name": "Service Véhicules",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "change-me-vehicle-secret",
      "defaultClientScopes": ["roles", "fleet.read", "fleet.write"]
    },
    {
      "clientId": "driver-service",
      "name": "Service Conducteurs",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "change-me-driver-secret",
      "defaultClientScopes": ["roles", "fleet.read", "fleet.write"]
    },
    {
      "clientId": "maintenance-service",
      "name": "Service Maintenance",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "change-me-maintenance-secret",
      "defaultClientScopes": ["roles", "fleet.read", "fleet.write"]
    },
    {
      "clientId": "location-service",
      "name": "Service Localisation",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "change-me-location-secret",
      "defaultClientScopes": ["roles", "fleet.read", "fleet.write"]
    },
    {
      "clientId": "event-service",
      "name": "Service Événements",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "change-me-event-secret",
      "defaultClientScopes": ["roles", "fleet.read", "fleet.write"]
    }
  ],

  "users": [
    {
      "username": "admin-fleet",
      "email": "admin@fleet.local",
      "firstName": "Admin",
      "lastName": "Flotte",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Admin1234!", "temporary": true }],
      "realmRoles": ["admin"]
    },
    {
      "username": "manager-fleet",
      "email": "manager@fleet.local",
      "firstName": "Manager",
      "lastName": "Flotte",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Manager1234!", "temporary": true }],
      "realmRoles": ["manager"]
    },
    {
      "username": "technicien-fleet",
      "email": "tech@fleet.local",
      "firstName": "Technicien",
      "lastName": "Flotte",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Tech1234!", "temporary": true }],
      "realmRoles": ["technicien"]
    },
    {
      "username": "conducteur-fleet",
      "email": "conducteur@fleet.local",
      "firstName": "Jean",
      "lastName": "Dupont",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "User1234!", "temporary": true }],
      "realmRoles": ["utilisateur"]
    }
  ]
}
