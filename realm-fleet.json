{
  "realm": "fleet-management",
  "displayName": "Système de Gestion de Flotte",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,

  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrateur — accès complet à toute la plateforme et gestion des droits"
      },
      {
        "name": "manager",
        "description": "Manager — supervise la flotte, les conducteurs et les alertes"
      },
      {
        "name": "technicien",
        "description": "Technicien — consulte et met à jour le statut des interventions de maintenance"
      },
      {
        "name": "utilisateur",
        "description": "Conducteur / Utilisateur — consulte ses assignations et utilise les véhicules"
      }
    ]
  },

  "clients": [
    {
      "clientId": "fleet-frontend",
      "name": "Application Web Flotte",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    },
    {
      "clientId": "fleet-api-gateway",
      "name": "API Gateway GraphQL",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "vehicle-service",
      "name": "Service Véhicules",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "driver-service",
      "name": "Service Conducteurs",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "maintenance-service",
      "name": "Service Maintenance",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "location-service",
      "name": "Service Localisation",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "event-service",
      "name": "Service Événements",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "serviceAccountsEnabled": true
    }
  ],

  "users": [
    {
      "username": "admin-fleet",
      "email": "admin@fleet.local",
      "firstName": "Admin",
      "lastName": "Flotte",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Admin1234!", "temporary": true }],
      "realmRoles": ["admin"]
    },
    {
      "username": "manager-fleet",
      "email": "manager@fleet.local",
      "firstName": "Manager",
      "lastName": "Flotte",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Manager1234!", "temporary": true }],
      "realmRoles": ["manager"]
    },
    {
      "username": "technicien-fleet",
      "email": "tech@fleet.local",
      "firstName": "Technicien",
      "lastName": "Flotte",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Tech1234!", "temporary": true }],
      "realmRoles": ["technicien"]
    },
    {
      "username": "conducteur-fleet",
      "email": "conducteur@fleet.local",
      "firstName": "Jean",
      "lastName": "Dupont",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "User1234!", "temporary": true }],
      "realmRoles": ["utilisateur"]
    }
  ]
}
