{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "CPU Usage (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "P1809F7F5F5EE462" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "process_cpu_usage * 100",
          "legendFormat": "{{service_name}} - {{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "title": "Memory Usage (JVM/Node/Python)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "P1809F7F5F5EE462" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "JVM Heap - {{service_name}}",
          "refId": "A"
        },
        {
          "expr": "nodejs_heap_size_used_bytes",
          "legendFormat": "Node V8 - {{service_name}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "title": "Average Request Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "P1809F7F5F5EE462" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_sum[5m]) / rate(http_server_requests_seconds_count[5m])",
          "legendFormat": "HTTP Latency - {{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Request Rate (RPS)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "P1809F7F5F5EE462" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (service_name)",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "title": "Metrics Métier : Événements Créés",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "P1809F7F5F5EE462" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(fleet_vehicles_created_total_total)",
          "legendFormat": "Vehicles Created",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Metrics Métier : Erreurs Opérationnelles",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "P1809F7F5F5EE462" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "targets": [
        {
          "expr": "sum(fleet_vehicles_operations_errors_total)",
          "legendFormat": "Operation Errors",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "title": "Fleet Comprehensive Monitoring (CPU, RAM, Latency, Business)",
  "uid": "fleet-comprehensive",
  "version": 1
}
